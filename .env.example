# ImpactOS Environment Configuration
APP_ENV=development
API_PORT=8000

# Gemini AI Configuration
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-3.8-flash

# Database Configuration (PostgreSQL with asyncpg; defaults to sqlite+aiosqlite for local self-contained runs)
DATABASE_URL=sqlite+aiosqlite:///./impactos.db
# DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/impactos

# Redis Configuration (Job queue & pub/sub; falls back to in-memory async broker if not reachable)
REDIS_URL=redis://localhost:6379/0

# Mapbox Access Token (for Phase 2 maps)
NEXT_PUBLIC_MAPBOX_TOKEN=
